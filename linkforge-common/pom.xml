<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.miuxuer</groupId>
        <artifactId>linkforge</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>linkforge-common</artifactId>
    <name>linkforge-common</name>
    <description>基础设施：Result / 异常 / 常量 / ThreadLocal / 配置属性 / 工具类，零业务</description>

    <!--
      本模块不依赖 pojo 和 server，处在依赖链最底层。
      具体依赖（jjwt、zxing、oss）等用到它们的工具类落地时再加，
      避免现在挂一堆编译期用不上的包。
    -->
    <dependencies>
        <!--
          本模块要写 @ConfigurationProperties / @Component 这类 Spring 注解，
          所以需要 Spring 基础包。引 starter 而不是逐个引 spring-context + spring-boot，
          是因为后续还要加 spring-web（工具类要读请求上下文）等，逐个列容易漏。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
          JJWT 三件套的分工，scope 不能写错：
          - api     编译期：Jwts / Claims 这些接口在这里，写代码只需要它
          - impl    运行期：真正的签名、解析实现，编译时用不到，放 compile 只是污染传递依赖
          - jackson 运行期：负责把 claims 序列化成 JSON。JJWT 只提供接口，
                    具体用哪个 JSON 库由这个包决定（也有 jjwt-gson 可选）
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          密码哈希用。只引 spring-security-crypto 这一个 jar，不是 spring-boot-starter-security
          —— starter 会把整条过滤器链拉进来，默认给所有接口套上 HTTP Basic 认证和登录页，
          跟本项目自己写的 JWT 拦截器打架。这里只要 BCrypt 算法本身。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
